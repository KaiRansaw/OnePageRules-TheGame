    {
      "name": "Unwieldy on its weapons in melee",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Unwieldy",
