  "ruleDefinitions": [
    {
      "name": "Rune of Spite Effect",
      "passive": [
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Advance"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Advance",
            "distanceInches": -2,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Rush"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Rush",
            "distanceInches": -4,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Charge"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Charge",
            "distanceInches": -4,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Negative",
      "description": "Moves -2\u0022 when using Advance, and -4\u0022 when using Rush/Charge (from Rune of Spite)."
    },
    {
      "name": "Spell Accumulator",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "AccumulatorTokens"
            },
            "count": {
              "kind": "arg",
              "index": 0
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 6
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellLending",
            "pool": {
              "id": "AccumulatorTokens"
            },
            "rangeInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Gets X accumulator tokens at the start of each round, but can\u0027t hold more than 6 tokens at once. Casters from other friendly units within 12\u0022 may spend this unit\u0027s accumulator tokens as if they were their own spell tokens. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Infiltrate",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "deferDeployment",
            "timing": "LaterRound",
            "placementRangeInches": 3,
            "minArrivalRound": 2,
            "mandatoryArrival": false
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Kept in reserve; may arrive from round 2 onward, placed anywhere over 3\u0022 from enemy units."
    },
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model charges, its weapons get AP(\u002B2) against units where most models have Tough 3\u002B."
    },
    {
      "name": "Sturdy",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "attackedFromOverInches",
              "distanceInches": 9
            },
            "right": {
              "kind": "allModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This unit gets \u002B1 to defense rolls when shot or charged from over 9 inches away."
    },
