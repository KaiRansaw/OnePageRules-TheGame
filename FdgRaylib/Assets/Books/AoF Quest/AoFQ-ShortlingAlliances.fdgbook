  "ruleDefinitions": [
    {
      "name": "Swift Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Swift"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Swift."
    },
    {
      "name": "Indirect when Shooting Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Indirect when shooting"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Indirect when shooting."
    },
    {
      "name": "Precision Frenzy",
      "passive": [
        {
          "hookID": "Shooting_OnUnitDestroyed",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "PrecisionFrenzyMarker"
            },
            "count": {
              "kind": "literal",
              "value": 1
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 2
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "tokenPresent",
            "tType": {
              "id": "PrecisionFrenzyMarker"
            },
            "minCount": 1
          },
          "effect": {
            "kind": "tokenScaledRollModifier",
            "tType": {
              "id": "PrecisionFrenzyMarker"
            },
            "rollKind": "Hit",
            "delta": 1,
            "perMarkers": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Gains a marker when it fully destroys an enemy unit (max 2); each marker adds \u002B1 to its hit rolls for the rest of the game."
    },
    {
      "name": "Repel Ambushers",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "repelAmbushers",
            "distanceInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Enemy units using Ambush must be set up over 12\u0022 away from this model\u0027s unit."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Obliterate",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreRule",
            "ruleName": "Regeneration"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "targetMajorityHasTough",
            "minToughValue": 3
          },
          "effect": {
            "kind": "reroll",
            "roll": "Save",
            "condition": {
              "kind": "onUnmodifiedValue",
              "minValue": 5
            }
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Ignores Regeneration, and when attacking units where most models have Tough(3) or higher, the target must re-roll successful unmodified Defense results of 5-6."
    },
    {
      "name": "Brace",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "negate",
              "inner": {
                "kind": "arg",
                "index": 0
              }
            },
            "armorPenetration": 0
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued."
    },
    {
      "name": "Parry",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "isMelee"
            }
          },
          "effect": {
            "kind": "ignoreHitsOnRoll",
            "dicePerModel": {
              "kind": "arg",
              "index": 0
            },
            "successThreshold": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "When this unit takes hits in melee, roll X dice per model with this rule in it, up to as many dice as hits taken. For each 6\u002B one hit is ignored."
    },
    {
      "name": "Tenacious",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "isMelee"
                }
              },
              "right": {
                "kind": "attackedFromOverInches",
                "distanceInches": 9
              }
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "and",
              "left": {
                "kind": "isMelee"
              },
              "right": {
                "kind": "attackedFromOverInches",
                "distanceInches": 6
              }
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, they get \u002B1 to Defense rolls when shot/charged from over 9 inches/6 inches away."
    },
    {
      "name": "Enhanced Tenacious",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "unitHasRule",
              "ruleName": "Tenacious"
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have Tenacious, they always get \u002B1 to Defense rolls from Tenacious (instead of only when shot/charged from over 9 inches/6 inches away)."
    },
