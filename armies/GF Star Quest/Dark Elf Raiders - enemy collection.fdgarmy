  "ruleDefinitions": [
    {
      "name": "Infiltrate",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "deferDeployment",
            "timing": "LaterRound",
            "placementRangeInches": 3,
            "minArrivalRound": 2,
            "mandatoryArrival": false
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Kept in reserve; may arrive from round 2 onward, placed anywhere over 3\u0022 from enemy units."
    },
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model charges, its weapons get AP(\u002B2) against units where most models have Tough 3\u002B."
    },
    {
      "name": "Regeneration Buff",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 12,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Friend",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Regeneration",
            "scope": "NextTrigger"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one friendly unit within 12 inches, which gains Regeneration for its next relevant roll."
    },
    {
      "name": "Precision Fighting Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Precision Fighting"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18 inches in line of sight. The first friendly attack against it this activation gets \u002B1 to hit rolls in melee."
    },
    {
      "name": "Piercing Frenzy",
      "passive": [
        {
          "hookID": "Shooting_OnUnitDestroyed",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "PiercingFrenzyMarker"
            },
            "count": {
              "kind": "literal",
              "value": 1
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 2
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "tokenPresent",
            "tType": {
              "id": "PiercingFrenzyMarker"
            },
            "minCount": 1
          },
          "effect": {
            "kind": "tokenScaledRollModifier",
            "tType": {
              "id": "PiercingFrenzyMarker"
            },
            "rollKind": "Save",
            "delta": -1,
            "perMarkers": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Gains a marker when it fully destroys an enemy unit (max 2); each marker adds AP(\u002B1) to its attacks for the rest of the game."
    },
    {
      "name": "Heavy Impact",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "arg",
              "index": 0
            },
            "armorPenetration": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "On charging into contact, rolls X bonus dice that score automatic hits with AP(1) before melee swings."
    },
    {
      "name": "Regenerative Strength",
      "passive": [
        {
          "hookID": "Lifecycle_OnWoundIgnored",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantIgnoredWoundMarker",
            "tType": {
              "id": "RegenerativeStrengthMarker"
            },
            "clear": {
              "kind": "manualOnly"
            }
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Place one marker on this model when it ignores a wound. When in melee, pick one of its weapons to get \u002BX attacks, where X is the number of markers on it."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Dodge",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "and",
              "left": {
                "kind": "mostModelsHaveThisRule"
              },
              "right": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, as long as they aren\u0027t Fatigued, enemy units get -1 to hit rolls in melee against them."
    },
