  "ruleDefinitions": [
    {
      "name": "Spell Conduit",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellRelay",
            "rangeInches": 12,
            "castRollBonus": 1
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Casters within 12\u0022 that are from other friendly units may cast spells as if they were in this unit\u0027s position, and get \u002B1 to casting rolls when doing so. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Primal",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unmodifiedRollEquals",
            "dieValue": 6
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Each unmodified 6 to hit scores an extra hit."
    },
    {
      "name": "Shred Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Shred"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18 inches in line of sight. The first friendly attack against it this activation gets Shred."
    },
    {
      "name": "Steadfast",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            },
            "right": {
              "kind": "allModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "clearTokenOnRoll",
            "tType": {
              "id": "Shaken"
            },
            "minRoll": 4
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this unit is Shaken at the start of the round, roll one die. On a 4\u002B it stops being Shaken."
    },
    {
      "name": "Bounding",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "repositionAtActivation",
            "distance": {
              "kind": "d3",
              "count": 1
            },
            "plusInches": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, it may place all its models anywhere fully within D3\u002B1 inches of their position."
    },
    {
      "name": "Banner",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
          "condition": {
            "kind": "moraleTriggeredByCombat"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Morale",
            "delta": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit gets \u002B1 to morale test rolls triggered by shooting or melee."
    },
    {
      "name": "Musician",
      "passive": [
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Advance"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Advance",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Rush"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Rush",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Charge"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Charge",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit moves \u002B1 inch on Advance, Rush and Charge actions."
    },
    {
      "name": "Sergeant",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model gets AP(\u002B1) when attacking."
    },
    {
      "name": "Precision Target",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "grantToken",
