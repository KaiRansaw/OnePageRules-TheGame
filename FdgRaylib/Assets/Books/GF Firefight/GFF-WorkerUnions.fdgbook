    {
      "name": "Quick Shot",
      "passive": [
        {
          "hookID": "Activation_OnActionChoice",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "shootAfterRush"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
