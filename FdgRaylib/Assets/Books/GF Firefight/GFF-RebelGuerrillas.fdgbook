  "ruleDefinitions": [
    {
      "name": "Strider Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Strider"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Strider."
    },
    {
      "name": "Armor",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "setDefense",
            "defense": {
              "kind": "arg",
              "index": 0
            }
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Counts as having Defense X\u002B in place of the model\u0027s own Defense stat."
    },
    {
      "name": "Piercing Tag",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 24,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "SpendableApBonusMarker"
            },
            "count": {
              "kind": "arg",
              "index": 0
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 0
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Once per game during its activation: pick one enemy within 24 inches in line of sight and place X markers on it. Attackers may remove markers from it before it rolls to block, gaining AP(\u002B1) per removed marker."
    },
    {
      "name": "Ambushing Piercing Shot",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "deferDeployment",
            "timing": "LaterRound",
            "placementRangeInches": 9,
            "minArrivalRound": 2,
            "mandatoryArrival": false
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "not",
              "inner": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "tokenPresent",
              "tType": {
                "id": "ArrivedFromReserve"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Counts as having Ambush, and its weapons get AP(\u002B1) when shooting on the round in which it deploys via this rule."
    },
    {
      "name": "Takedown Strike",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Combat_OnAttackWindow",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "extraAttack",
            "weaponName": "Takedown Strike",
            "attacks": {
              "kind": "arg",
              "index": 0
            },
            "armorPenetration": 2,
            "withRules": [
              "Reliable",
              "Deadly(3)",
              "Takedown"
            ]
          },
          "availableWhen": {
            "kind": "isMelee"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Once per game, when it\u0027s this model\u0027s turn to strike in melee, it may make X attacks at Quality 2\u002B with AP(2), Deadly(3), and Takedown."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Reap",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "or",
            "left": {
              "kind": "targetTokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            },
            "right": {
              "kind": "targetTokenPresent",
              "tType": {
                "id": "Fatigued"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "reroll",
            "roll": "Save",
            "condition": {
              "kind": "onUnmodifiedValue",
              "minValue": 5
            }
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When attacking units that are Shaken or Fatigued, the target must re-roll successful unmodified Defense results of 5-6."
    },
    {
      "name": "Counter in Melee",
      "passive": [
        {
          "hookID": "Melee_OnCounterTrigger",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "strikeFirst"
          },
          "lifetime": "ThisActivation",
          "seat": "Subject"
        },
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "reduceImpactDicePerModel"
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When charged, this unit strikes first and the charger rolls one fewer Impact die per living model."
    },
    {
      "name": "Enhanced Guerrilla Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Enhanced Guerrilla"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Enhanced Guerrilla."
    },
    {
      "name": "Guerrilla",
      "passive": [
        {
          "hookID": "Shooting_OnPostShoot",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 3,
            "isOptional": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
