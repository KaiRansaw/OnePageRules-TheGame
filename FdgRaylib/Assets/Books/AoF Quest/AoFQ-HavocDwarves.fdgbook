  "ruleDefinitions": [
    {
      "name": "Spell Conduit",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellRelay",
            "rangeInches": 12,
            "castRollBonus": 1
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Casters within 12\u0022 that are from other friendly units may cast spells as if they were in this unit\u0027s position, and get \u002B1 to casting rolls when doing so. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model charges, its weapons get AP(\u002B2) against units where most models have Tough 3\u002B."
    },
