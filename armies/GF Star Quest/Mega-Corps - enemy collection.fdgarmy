            ]
          },
          "availableWhen": {
            "kind": "not",
            "inner": {
              "kind": "isMelee"
            }
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Once per game, when this model shoots, it may make X extra attacks against the target at Quality 2\u002B with AP(2), Deadly(3), and Takedown."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
