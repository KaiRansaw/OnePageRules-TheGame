  "ruleDefinitions": [
    {
      "name": "Infected",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "addExtraWound",
            "onRollValue": 1,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Each of the defender\u0027s unmodified Defense rolls of 1 deals an extra wound."
    },
    {
      "name": "Thrust in Melee Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Thrust"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Thrust."
    },
    {
      "name": "Precision Growth",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Shaken"
                },
                "minCount": 1
              }
            },
            "right": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "tokenPresent",
                  "tType": {
                    "id": "InReserve"
                  },
                  "minCount": 1
                }
              },
              "right": {
                "kind": "and",
                "left": {
                  "kind": "not",
                  "inner": {
                    "kind": "tokenPresent",
                    "tType": {
                      "id": "EmbarkedIn"
                    },
                    "minCount": 1
                  }
                },
                "right": {
                  "kind": "not",
                  "inner": {
                    "kind": "tokenPresent",
                    "tType": {
                      "id": "OffTableFromForcedMove"
                    },
                    "minCount": 1
                  }
                }
              }
            }
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "PrecisionGrowthMarker"
            },
            "count": {
              "kind": "literal",
              "value": 1
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 4
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "tokenPresent",
            "tType": {
              "id": "PrecisionGrowthMarker"
            },
            "minCount": 2
          },
          "effect": {
            "kind": "tokenScaledRollModifier",
            "tType": {
              "id": "PrecisionGrowthMarker"
            },
            "rollKind": "Hit",
            "delta": 1,
            "perMarkers": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Gains a marker at the start of each round while on the table and not Shaken (max 4); every two markers add \u002B1 to its hit rolls."
    },
    {
      "name": "No Retreat Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "No Retreat"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get No Retreat."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Enhanced Infected",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "unitHasRule",
            "ruleName": "Infected"
          },
          "effect": {
            "kind": "addExtraWound",
            "onRollValue": 1,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Infected, enemies always take wounds on unmodified results of 1 to block from Infected (instead of only when shooting/charging enemies over 9 inches/6 inches away)."
    },
    {
      "name": "Decimate",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "targetAboveHalfStrength"
          },
          "effect": {
            "kind": "reroll",
            "roll": "Save",
            "condition": {
              "kind": "onUnmodifiedValue",
              "minValue": 6
            }
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When attacking units with more than half of their total size or Tough value (for single-model units), the target must re-roll unmodified Defense results of 6."
    },
    {
      "name": "Enhanced Infected Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Enhanced Infected"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Enhanced Infected."
    },
    {
      "name": "No Retreat",
      "passive": [
        {
          "hookID": "Morale_OnMoraleTestComplete",
          "condition": {
            "kind": "mostModelsHaveThisRule"
          },
          "effect": {
            "kind": "passFailedMoraleTest",
            "selfWoundOnRollAtMost": 3
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When a unit where most models have this rule fails a morale test that causes it to be Shaken or Routed, the test counts as passed instead. Then, roll as many dice as the number of wounds it would take to fully destroy it, and for each result of 1-3 the unit takes one wound, which can\u0027t be ignored."
    }
  ],
