            "rollKind": "Hit",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Targeting Visor, it always gets \u002B1 to hit rolls from Targeting Visor (instead of only when shooting over 9 inches away)."
    },
