  "ruleDefinitions": [
    {
      "name": "Predator Shooter",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "not",
              "inner": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "unmodifiedRollEquals",
              "dieValue": 6
            }
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Each unmodified 6 to hit when shooting scores an extra hit."
    },
    {
      "name": "Predator Shooter Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Predator Shooter"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Predator Shooter."
    },
