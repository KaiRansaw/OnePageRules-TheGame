                "kind": "tokenPresent",
                "tType": {
                  "id": "Shaken"
                },
                "minCount": 1
              }
            },
            "right": {
              "kind": "and",
              "left": {
                "kind": "not",
                "inner": {
                  "kind": "tokenPresent",
                  "tType": {
                    "id": "InReserve"
                  },
                  "minCount": 1
                }
              },
              "right": {
                "kind": "and",
                "left": {
                  "kind": "not",
                  "inner": {
                    "kind": "tokenPresent",
                    "tType": {
                      "id": "EmbarkedIn"
                    },
                    "minCount": 1
                  }
                },
                "right": {
                  "kind": "not",
                  "inner": {
                    "kind": "tokenPresent",
                    "tType": {
                      "id": "OffTableFromForcedMove"
                    },
                    "minCount": 1
                  }
                }
              }
            }
          },
          "effect": {
            "kind": "grantToken",
