  "ruleDefinitions": [
    {
      "name": "Bane Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Bane"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18 inches in line of sight. The first friendly attack against it this activation gets Bane."
    },
    {
      "name": "Bounding",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "repositionAtActivation",
            "distance": {
              "kind": "d3",
              "count": 1
            },
            "plusInches": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, it may place all its models anywhere fully within D3\u002B1 inches of their position."
    },
    {
      "name": "Protection Feat Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Protection Feat"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Protection Feat."
    },
    {
      "name": "Repel Ambushers",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "repelAmbushers",
            "distanceInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Enemy units using Ambush must be set up over 12\u0022 away from this model\u0027s unit."
    },
    {
      "name": "No Retreat",
      "passive": [
        {
          "hookID": "Morale_OnMoraleTestComplete",
          "condition": {
            "kind": "mostModelsHaveThisRule"
          },
          "effect": {
            "kind": "passFailedMoraleTest",
            "selfWoundOnRollAtMost": 3
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When a unit where most models have this rule fails a morale test that causes it to be Shaken or Routed, the test counts as passed instead. Then, roll as many dice as the number of wounds it would take to fully destroy it, and for each result of 1-3 the unit takes one wound, which can\u0027t be ignored."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Puncture",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreRule",
            "ruleName": "Regeneration"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "statLessOrEqualTo",
            "stat": "Defense",
            "statValue": 3
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Ignores Regeneration, and when attacking units where most models have Defense 2\u002B to Defense 3\u002B, this weapon gets AP(\u002B2)."
    },
    {
      "name": "Psychotic",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "addExtraAttackRoll",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "For each unmodified roll of 6 to hit when attacking, this model may roll \u002B1 attack with that weapon. This rule does not apply to newly generated attacks."
    },
    {
      "name": "Enhanced Psychotic",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unitHasRule",
            "ruleName": "Psychotic"
          },
          "effect": {
            "kind": "addExtraAttackRoll",
            "onRollValue": 5,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unitHasRule",
            "ruleName": "Psychotic"
          },
          "effect": {
            "kind": "addExtraAttackRoll",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Psychotic, it gets extra attacks on successful unmodified hit results of 5-6 from Psychotic (instead of only on 6)."
    },
    {
      "name": "Bane on their weapons when attacking",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
