                "id": "Fatigued"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When attacking units that are Shaken or Fatigued, this weapon gets AP(\u002B2)."
    },
    {
      "name": "Shadow Operative",
      "passive": [
        {
          "hookID": "Shooting_OnRangeCheck",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "rangeModifier",
            "delta": -4,
            "minResultInches": 6
          },
          "lifetime": "ThisActivation",
          "seat": "Subject"
        },
        {
          "hookID": "Movement_OnChargeDeclared",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Charge",
            "distanceInches": -2,
            "minResultInches": 6
          },
          "lifetime": "ThisActivation",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When a unit where most models have this rule is targeted by an enemy unit for shooting/charging, that enemy unit gets -4 inches/-2 inches range to a min. of 6 inches."
    },
    {
      "name": "Enhanced Shadow Operative",
      "passive": [
        {
          "hookID": "Shooting_OnRangeCheck",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "unitHasRule",
