  "ruleDefinitions": [
    {
      "name": "Caster Group",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "enableCasting"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "SpellTokens"
            },
            "count": {
              "kind": "ruleCarrierCount"
            },
            "clear": {
              "kind": "roundEnd"
            },
            "maxTotal": 0
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "One model in this unit casts spells with as many spell tokens per round as there are models with this rule in the unit. Unspent tokens are lost at the end of the round."
    },
    {
      "name": "Mischievous",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "reroll",
            "roll": "Save",
            "condition": {
              "kind": "onUnmodifiedValue",
              "minValue": 6
            }
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The defender must re-roll unmodified Defense 6s."
    },
    {
      "name": "Piercing Fighter",
