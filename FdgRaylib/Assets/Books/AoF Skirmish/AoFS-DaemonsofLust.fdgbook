  "ruleDefinitions": [
    {
      "name": "Lustbound",
      "passive": [
        {
          "hookID": "Shooting_OnRangeCheck",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "rangeModifier",
            "delta": 4,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Charge"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Charge",
            "distanceInches": 2,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Gets \u002B4 inches range when shooting, and moves \u002B2 inches on Charge actions."
    },
