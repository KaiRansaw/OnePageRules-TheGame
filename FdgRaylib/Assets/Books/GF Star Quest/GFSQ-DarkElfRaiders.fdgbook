  "ruleDefinitions": [
    {
      "name": "Infiltrate",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "deferDeployment",
