              "kind": "d3",
              "count": 1
            },
            "plusInches": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this unit is activated, it may place all its models anywhere fully within D3\u002B1 inches of their position."
    },
    {
      "name": "Precision Target",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "grantToken",
