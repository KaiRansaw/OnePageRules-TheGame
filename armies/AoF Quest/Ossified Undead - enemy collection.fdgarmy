  "ruleDefinitions": [
    {
      "name": "Spell Accumulator",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "AccumulatorTokens"
            },
            "count": {
              "kind": "arg",
              "index": 0
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 6
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellLending",
            "pool": {
              "id": "AccumulatorTokens"
            },
            "rangeInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Gets X accumulator tokens at the start of each round, but can\u0027t hold more than 6 tokens at once. Casters from other friendly units within 12\u0022 may spend this model\u0027s accumulator tokens as if they were their own spell tokens."
    },
    {
      "name": "Infiltrate",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "deferDeployment",
            "timing": "LaterRound",
            "placementRangeInches": 3,
            "minArrivalRound": 2,
            "mandatoryArrival": false
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Counts as having Ambush, but may be deployed anywhere over 3\u0022 away from enemy unit."
    },
    {
      "name": "Shatter",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unmodifiedRollEquals",
            "dieValue": 6
          },
          "effect": {
            "kind": "perHitSaveModifier",
            "onRollValue": 6,
            "delta": -3
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "For each unmodified result of 6 to hit, those hits get AP(\u002B3)."
    },
    {
      "name": "Regeneration Buff",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 12,
            "minCount": 1,
            "maxCount": 3,
            "targetAffinity": "Friend",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Regeneration",
            "scope": "NextTrigger"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Only one use per game. Once per activation, before attacking, pick up to 3 friendly units within 12\u0022, which gets Regeneration once (next time the effect would apply)."
    },
    {
      "name": "Swift",
      "passive": [
        {
          "hookID": "Movement_OnMoveThroughTerrain",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreTerrainEffects",
            "scope": "DifficultOnly"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model may ignore the Slow rule."
    },
    {
      "name": "Swift Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Swift"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model\u0027s unit and up to 2 nearest friendly units picked before the start of the game get Swift. If this model is killed, picked models that are deployed lose the rule."
    },
    {
      "name": "Furious Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 3,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Furious"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Only one use per game. Once per activation, before attacking, pick up to 3 enemy units within 18\u0022 in line of sight, which friendly units gets Furious against once (next time the effect would apply)."
    },
    {
      "name": "Banner",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
          "condition": {
            "kind": "moraleTriggeredByCombat"
