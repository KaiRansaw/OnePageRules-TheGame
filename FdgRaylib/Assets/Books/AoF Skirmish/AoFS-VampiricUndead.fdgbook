            }
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022, which must take a morale test. If failed you may move it by up to 6\u0022 in a straight line in any direction."
    },
