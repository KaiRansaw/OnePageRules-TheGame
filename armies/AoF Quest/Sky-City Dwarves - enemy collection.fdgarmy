              },
              "count": 2
            }
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "Drain 2 spell tokens"
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy model within 18 inches in line of sight, which must take a Morale Test. If failed, it loses 2 spell tokens."
    },
