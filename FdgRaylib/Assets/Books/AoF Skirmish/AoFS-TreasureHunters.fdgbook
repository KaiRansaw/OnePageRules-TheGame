            "actionType": "Charge",
            "distanceInches": 2,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Moves \u002B1 inch when using Advance, and \u002B2 inches when using Rush/Charge."
    },
    {
      "name": "Brace",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "negate",
              "inner": {
                "kind": "arg",
                "index": 0
              }
            },
            "armorPenetration": 0
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued."
    },
    {
      "name": "Parry",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "isMelee"
            }
