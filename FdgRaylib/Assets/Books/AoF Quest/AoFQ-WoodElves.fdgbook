  "ruleDefinitions": [
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model charges, its weapons get AP(\u002B2) against units where most models have Tough 3\u002B."
    },
    {
      "name": "Banner",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
          "condition": {
            "kind": "moraleTriggeredByCombat"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Morale",
            "delta": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit gets \u002B1 to morale test rolls triggered by shooting or melee."
    },
    {
      "name": "Musician",
      "passive": [
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Advance"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Advance",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Rush"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Rush",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
