            }
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 6,
            "isOptional": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have Guerrilla, they may move by up to 6 inches from Guerrilla (instead of only 3)."
    }
