      "valence": "Positive",
      "description": "Enemy units using Ambush must be set up over 12\u0022 away from this model\u0027s unit."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Brace",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "negate",
              "inner": {
                "kind": "arg",
                "index": 0
              }
            },
            "armorPenetration": 0
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued."
    },
    {
      "name": "Parry",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "isMelee"
            }
          },
          "effect": {
            "kind": "ignoreHitsOnRoll",
            "dicePerModel": {
              "kind": "arg",
              "index": 0
            },
            "successThreshold": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "When this unit takes hits in melee, roll X dice per model with this rule in it, up to as many dice as hits taken. For each 6\u002B one hit is ignored."
    },
    {
      "name": "Brute Courage",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "clearTokenOnRoll",
            "tType": {
              "id": "Shaken"
            },
            "minRoll": 4
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4\u002B, it stops being Shaken."
    },
    {
      "name": "Scourge",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "bankTokenPerUnmodifiedSaveRoll",
            "tType": {
              "id": "MeleeWoundTally"
            },
            "onRollValue": 1,
            "perMatch": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Melee_OnMeleeResolution",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "tokenScaledExtraMeleeWoundCount",
            "tType": {
              "id": "MeleeWoundTally"
            },
            "perMarkers": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "For each unmodified result of 1 to block hits, enemies count as having taken 2 extra wounds when checking who won melee, or if shooting wounds would trigger Morale Tests."
    },
