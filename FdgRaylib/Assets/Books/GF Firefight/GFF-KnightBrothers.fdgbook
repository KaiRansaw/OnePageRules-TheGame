      "valence": "Positive",
      "description": "This model and its unit get Bravery."
    },
    {
      "name": "Unstoppable on their weapons when shooting",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Unstoppable",
            "scope": "ThisActivation"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model gets Unstoppable on its weapons when shooting."
    },
    {
      "name": "Enhanced Knightborn Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
