  "ruleDefinitions": [
    {
      "name": "Warbound",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "addExtraWound",
            "onRollValue": 1,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Each of the defender\u0027s unmodified Defense rolls of 1 deals an extra wound."
    },
    {
      "name": "Versatile Defense Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Versatile Defense"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit gain Versatile Defense."
    },
    {
