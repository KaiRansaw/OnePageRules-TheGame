[gd_scene format=3]

[node name="ArmyPickerLayout" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Top" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Column/Top"]
unique_name_in_owner = true
layout_mode = 2
text = "Choose an Army"

[node name="Crumb" type="Label" parent="Column/Top"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Army Forge  >  Grimdark Future"

[node name="Spacer" type="Control" parent="Column/Top"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="ArmySearch" type="LineEdit" parent="Column/Top"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Show only the armies whose name contains this."
placeholder_text = "Search armies..."
clear_button_enabled = true

[node name="Tabs" type="HBoxContainer" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Main" type="HBoxContainer" parent="Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="ListPanel" type="PanelContainer" parent="Column/Main"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Scroll" type="ScrollContainer" parent="Column/Main/ListPanel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Column/Main/ListPanel/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="InfoPanel" type="PanelContainer" parent="Column/Main"]
unique_name_in_owner = true
custom_minimum_size = Vector2(540, 0)
layout_mode = 2

[node name="InfoScroll" type="ScrollContainer" parent="Column/Main/InfoPanel"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="InfoBody" type="VBoxContainer" parent="Column/Main/InfoPanel/InfoScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="InfoPicture" type="Control" parent="Column/Main/InfoPanel/InfoScroll/InfoBody"]
unique_name_in_owner = true
clip_contents = true
custom_minimum_size = Vector2(0, 230)
layout_mode = 2
mouse_filter = 2

[node name="InfoArt" type="Control" parent="Column/Main/InfoPanel/InfoScroll/InfoBody/InfoPicture"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="InfoTitle" type="VBoxContainer" parent="Column/Main/InfoPanel/InfoScroll/InfoBody/InfoPicture"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -76.0
offset_right = -16.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = -2

[node name="InfoName" type="Label" parent="Column/Main/InfoPanel/InfoScroll/InfoBody/InfoPicture/InfoTitle"]
unique_name_in_owner = true
layout_mode = 2
text = "ALIEN HIVES"

[node name="InfoLine" type="Label" parent="Column/Main/InfoPanel/InfoScroll/InfoBody/InfoPicture/InfoTitle"]
unique_name_in_owner = true
layout_mode = 2
text = "Aliens  -  41 units  -  6 spells"

[node name="InfoAbout" type="Label" parent="Column/Main/InfoPanel/InfoScroll/InfoBody"]
unique_name_in_owner = true
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
text = "Army Forge's description of the army."
autowrap_mode = 3

[node name="SignatureHead" type="Label" parent="Column/Main/InfoPanel/InfoScroll/InfoBody"]
unique_name_in_owner = true
layout_mode = 2
text = "SIGNATURE UNITS"

[node name="Signature" type="HBoxContainer" parent="Column/Main/InfoPanel/InfoScroll/InfoBody"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="RulesHead" type="Label" parent="Column/Main/InfoPanel/InfoScroll/InfoBody"]
unique_name_in_owner = true
layout_mode = 2
text = "ARMY RULE"

[node name="Rules" type="VBoxContainer" parent="Column/Main/InfoPanel/InfoScroll/InfoBody"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="BottomPanel" type="PanelContainer" parent="Column"]
layout_mode = 2

[node name="Bottom" type="HBoxContainer" parent="Column/BottomPanel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ArmyPickerBack" type="Button" parent="Column/BottomPanel/Bottom"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 50)
layout_mode = 2
theme_type_variation = &"BackButton"
text = "Back"

[node name="Info" type="Label" parent="Column/BottomPanel/Bottom"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
text = "Pick an army"

[node name="ArmyPickerCommit" type="Button" parent="Column/BottomPanel/Bottom"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 54)
layout_mode = 2
theme_type_variation = &"CommitButton"
text = "CHOOSE THIS ARMY"
