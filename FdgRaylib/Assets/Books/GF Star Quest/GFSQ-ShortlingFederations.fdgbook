      "valence": "Positive",
      "description": "If most models in this unit have this rule, they get \u002B1 to Defense rolls when shot/charged from over 9 inches/6 inches away."
    },
    {
      "name": "Enhanced Safety Gear",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "unitHasRule",
              "ruleName": "Safety Gear"
            },
            "right": {
              "kind": "mostModelsHaveThisRule"
