            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When attacking units that are Shaken or Fatigued, this weapon gets AP(\u002B2)."
    },
    {
      "name": "Shadow Operative",
