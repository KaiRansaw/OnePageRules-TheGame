            "distanceInches": -4,
            "minResultInches": 6
          },
          "lifetime": "ThisActivation",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have Shadow Operative, enemy units shooting/charging it get -8 inches/-4 inches range to a min. of 6 inches from Shadow Operative (instead of only -4 inches/-2 inches)."
    },
