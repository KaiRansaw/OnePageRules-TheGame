  "ruleDefinitions": [
    {
      "name": "Spell Accumulator",
      "passive": [
        {
          "hookID": "Round_OnRoundStart",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "AccumulatorTokens"
            },
            "count": {
              "kind": "arg",
              "index": 0
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 6
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        },
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "not",
            "inner": {
              "kind": "tokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "enableSpellLending",
            "pool": {
              "id": "AccumulatorTokens"
            },
            "rangeInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Gets X accumulator tokens at the start of each round, but can\u0027t hold more than 6 tokens at once. Casters from other friendly units within 12\u0022 may spend this unit\u0027s accumulator tokens as if they were their own spell tokens. Friendly casters may only use this rule if this unit isn\u0027t Shaken."
    },
    {
      "name": "Banner",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Morale",
            "delta": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit gets \u002B1 to morale test rolls."
    },
    {
      "name": "Musician",
      "passive": [
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Advance"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Advance",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Rush"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Rush",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Charge"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Charge",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit moves \u002B1 inch on Advance, Rush and Charge actions."
    },
    {
      "name": "Sergeant",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unmodifiedRollEquals",
            "dieValue": 6
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model attacks, unmodified results of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules)."
    },
    {
      "name": "Armor",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "setDefense",
            "defense": {
              "kind": "arg",
              "index": 0
            }
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Counts as having Defense X\u002B in place of the model\u0027s own Defense stat."
    },
    {
      "name": "Repel Ambushers",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "repelAmbushers",
            "distanceInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Enemy units using Ambush must be set up over 12\u0022 away from this model\u0027s unit."
    },
    {
      "name": "Ambush Re-Deployment",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "tokenPresent",
            "tType": {
              "id": "PendingAmbushArrival"
            },
            "minCount": 1
          },
          "effect": {
            "kind": "deferDeployment",
            "timing": "LaterRound",
            "placementRangeInches": 9,
            "minArrivalRound": 2,
            "mandatoryArrival": true
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [
        {
          "triggerHook": "Activation_OnEndOfActivation",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Self",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "ambushRedeploy"
          },
          "availableWhen": {
            "kind": "allModelsHaveThisRule"
          },
          "label": "Ambush Re-Deployment"
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per game, when a unit where all models have this rule ends its activation, you may immediately remove it from the table (dropping any objectives it might hold within 1\u0022), and deploy it as if it had Ambush at the beginning of the next round."
    },
    {
      "name": "Quick Shot",
      "passive": [
        {
          "hookID": "Activation_OnActionChoice",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "shootAfterRush"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model may shoot after using Rush actions."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Dodge",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "and",
              "left": {
                "kind": "mostModelsHaveThisRule"
              },
              "right": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, as long as they aren\u0027t Fatigued, enemy units get -1 to hit rolls in melee against them."
    },
    {
      "name": "Reap",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "or",
            "left": {
              "kind": "targetTokenPresent",
              "tType": {
                "id": "Shaken"
              },
              "minCount": 1
            },
            "right": {
              "kind": "targetTokenPresent",
              "tType": {
                "id": "Fatigued"
              },
              "minCount": 1
            }
          },
          "effect": {
            "kind": "reroll",
            "roll": "Save",
            "condition": {
              "kind": "onUnmodifiedValue",
              "minValue": 5
            }
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When attacking units that are Shaken or Fatigued, the target must re-roll successful unmodified Defense results of 5-6."
    },
    {
      "name": "Brace",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "negate",
              "inner": {
                "kind": "arg",
                "index": 0
              }
            },
            "armorPenetration": 0
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued."
    },
    {
      "name": "Parry",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "isMelee"
            }
          },
          "effect": {
            "kind": "ignoreHitsOnRoll",
            "dicePerModel": {
              "kind": "arg",
              "index": 0
            },
            "successThreshold": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "When this unit takes hits in melee, roll X dice per model with this rule in it, up to as many dice as hits taken. For each 6\u002B one hit is ignored."
    },
    {
      "name": "Enhanced Wave-Step Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Enhanced Wave-Step"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Enhanced Wave-Step."
    },
    {
      "name": "Wave-Step",
      "passive": [
        {
          "hookID": "Activation_OnActivationStart",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "repositionAtActivation",
            "distance": {
              "kind": "d3",
              "count": 1
            },
            "plusInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
