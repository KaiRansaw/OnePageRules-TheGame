            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "and",
              "left": {
                "kind": "isMelee"
              },
              "right": {
