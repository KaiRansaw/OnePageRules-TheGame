  "ruleDefinitions": [
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model charges, its weapons get AP(\u002B2) against units where most models have Tough 3\u002B."
    },
    {
      "name": "Banner",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
          "condition": {
            "kind": "moraleTriggeredByCombat"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Morale",
            "delta": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit gets \u002B1 to morale test rolls triggered by shooting or melee."
    },
    {
      "name": "Musician",
      "passive": [
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Advance"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Advance",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Rush"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Rush",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Movement_OnMoveActionDeclared",
          "condition": {
            "kind": "actionTypeIs",
            "actionType": "Charge"
          },
          "effect": {
            "kind": "movementBonus",
            "actionType": "Charge",
            "distanceInches": 1,
            "minResultInches": 0
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "The unit moves \u002B1 inch on Advance, Rush and Charge actions."
    },
    {
      "name": "Sergeant",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unmodifiedRollEquals",
            "dieValue": 6
          },
          "effect": {
            "kind": "addExtraHit",
            "onRollValue": 6,
            "count": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model attacks, unmodified results of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules)."
    },
    {
      "name": "Speed Debuff",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Slow",
            "scope": "NextTrigger"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which moves -2\u0022 when using Advance actions and -4\u0022 when using Rush/Charge actions once (next time the effect would apply)."
    },
    {
      "name": "Heavy Impact",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "arg",
              "index": 0
            },
            "armorPenetration": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "On charging into contact, rolls X bonus dice that score automatic hits with AP(1) before melee swings."
    },
    {
      "name": "Repel Ambushers",
      "passive": [
        {
          "hookID": "Lifecycle_OnCapabilityQuery",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "repelAmbushers",
            "distanceInches": 12
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Enemy units using Ambush must be set up over 12\u0022 away from this model\u0027s unit."
    },
    {
      "name": "Spawn",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnActivationStart",
          "cost": {
            "kind": "oncePerGame"
          },
          "targetSelector": {
            "rangeInches": 0,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Self",
            "requireLineOfSight": false,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "spawnUnit",
            "radiusInches": 6
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": "Spawn"
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Once per game, when this model is activated, you may place a new unit of X fully within 6\u0022 of it."
    },
    {
      "name": "Quick Shot",
      "passive": [
        {
          "hookID": "Activation_OnActionChoice",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "shootAfterRush"
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model may shoot after using Rush actions."
    },
    {
      "name": "Quick Shot Mark",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "markTarget",
            "ruleName": "Quick Shot"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight. One friendly unit that used a Rush action may still shoot it once."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Anti-Regen",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreRule",
            "ruleName": "Regeneration"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Regeneration."
    },
    {
      "name": "Spell Resistance",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "isSpell"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
