    },
    {
      "name": "Heavy Impact",
      "passive": [
        {
          "hookID": "Melee_OnChargeContact",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "chargeImpactHits",
            "diceCount": {
              "kind": "arg",
              "index": 0
            },
            "armorPenetration": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "On charging into contact, rolls X bonus dice that score automatic hits with AP(1) before melee swings."
    },
    {
      "name": "Dangerous Terrain Debuff",
      "passive": [],
      "activated": [
        {
          "triggerHook": "Activation_OnBeforeAttackAction",
          "cost": {
            "kind": "oncePerActivation"
          },
          "targetSelector": {
            "rangeInches": 18,
            "minCount": 1,
            "maxCount": 1,
            "targetAffinity": "Foe",
            "requireLineOfSight": true,
            "requiredToken": null,
            "singleModel": false,
            "requiredRule": null
          },
          "effect": {
            "kind": "addRule",
            "ruleName": "Dangerous Terrain Debuff Effect",
            "scope": "NextTrigger"
          },
          "availableWhen": {
            "kind": "always"
          },
          "label": ""
        }
      ],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per activation, before attacking, pick one enemy unit within 18\u0022 in line of sight, which counts as being in Dangerous Terrain once (next time the effect would apply)."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Spell Resistance",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "isSpell"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "mostModelsHaveThisRule"
            },
            "right": {
              "kind": "isNotSpell"
            }
          },
          "effect": {
            "kind": "ignoreWoundOnRoll",
            "minRoll": 6
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When a unit where most models have this rule takes wounds, roll one die for each. A wound from a spell is ignored on a 2\u002B, and any other wound on a 6\u002B."
    },
    {
      "name": "Enhanced Havocbound",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "unitHasRule",
            "ruleName": "Havocbound"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If this model has Havocbound, it always gets AP(\u002B1) from Havocbound (instead of only when shooting/charging enemies over 9 inches/6 inches away)."
    },
    {
      "name": "Scourge",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollComplete",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "bankTokenPerUnmodifiedSaveRoll",
            "tType": {
              "id": "MeleeWoundTally"
            },
            "onRollValue": 1,
            "perMatch": 2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        },
        {
          "hookID": "Melee_OnMeleeResolution",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "tokenScaledExtraMeleeWoundCount",
            "tType": {
              "id": "MeleeWoundTally"
            },
            "perMarkers": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "For each unmodified result of 1 to block hits, enemies count as having taken 2 extra wounds when checking who won melee, or if shooting wounds would trigger Morale Tests."
    },
    {
