  "ruleDefinitions": [
    {
      "name": "Infiltrate",
      "passive": [
        {
          "hookID": "Deployment_OnPreDeploymentSelect",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "deferDeployment",
            "timing": "LaterRound",
            "placementRangeInches": 3,
            "minArrivalRound": 2,
            "mandatoryArrival": false
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Kept in reserve; may arrive from round 2 onward, placed anywhere over 3\u0022 from enemy units."
    },
    {
      "name": "Melee Slayer",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "isCharging"
            },
            "right": {
              "kind": "targetMajorityHasTough",
              "minToughValue": 3
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -2
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When this model charges, its weapons get AP(\u002B2) against units where most models have Tough 3\u002B."
    },
    {
      "name": "Armor",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "setDefense",
            "defense": {
              "kind": "arg",
              "index": 0
            }
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 1,
      "valence": "Positive",
      "description": "Counts as having Defense X\u002B in place of the model\u0027s own Defense stat."
    },
    {
      "name": "Piercing Frenzy",
      "passive": [
        {
          "hookID": "Shooting_OnUnitDestroyed",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "grantToken",
            "tType": {
              "id": "PiercingFrenzyMarker"
            },
            "count": {
              "kind": "literal",
              "value": 1
            },
            "clear": {
              "kind": "manualOnly"
            },
            "maxTotal": 2
          },
          "lifetime": "ThisRound",
          "seat": "Actor"
        },
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "tokenPresent",
            "tType": {
              "id": "PiercingFrenzyMarker"
            },
            "minCount": 1
          },
          "effect": {
            "kind": "tokenScaledRollModifier",
            "tType": {
              "id": "PiercingFrenzyMarker"
            },
            "rollKind": "Save",
            "delta": -1,
            "perMarkers": 1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Gains a marker when it fully destroys an enemy unit (max 2); each marker adds AP(\u002B1) to its attacks for the rest of the game."
    },
    {
      "name": "Anti-Cover",
      "passive": [
        {
          "hookID": "Shooting_OnSaveRollModifier",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "ignoreCover"
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Weapon",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This weapon ignores Cover."
    },
    {
      "name": "Dodge",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "and",
              "left": {
                "kind": "mostModelsHaveThisRule"
              },
              "right": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "not",
              "inner": {
                "kind": "tokenPresent",
                "tType": {
                  "id": "Fatigued"
                },
                "minCount": 1
              }
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have this rule, as long as they aren\u0027t Fatigued, enemy units get -1 to hit rolls in melee against them."
    },
    {
      "name": "Bravery Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Bravery"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Bravery."
    },
    {
      "name": "Piercing Marksman Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Piercing Marksman"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Piercing Marksman."
    },
    {
      "name": "Enhanced Harassing Aura",
      "passive": [
        {
          "hookID": "Lifecycle_OnUnitCreated",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "aura",
            "ruleName": "Enhanced Harassing"
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get Enhanced Harassing."
    },
    {
      "name": "Harassing",
      "passive": [
        {
          "hookID": "Shooting_OnPostShoot",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 3,
            "isOptional": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Melee_OnPostMelee",
          "condition": {
            "kind": "allModelsHaveThisRule"
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 3,
            "isOptional": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Once per round, this model may move by up to 3 inches after shooting or being in melee."
    },
    {
      "name": "Enhanced Harassing",
      "passive": [
        {
          "hookID": "Shooting_OnPostShoot",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "unitHasRule",
              "ruleName": "Harassing"
            }
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 6,
            "isOptional": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        },
        {
          "hookID": "Melee_OnPostMelee",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "allModelsHaveThisRule"
            },
            "right": {
              "kind": "unitHasRule",
              "ruleName": "Harassing"
            }
          },
          "effect": {
            "kind": "triggeredMove",
            "maxInches": 6,
            "isOptional": true
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "If most models in this unit have Harassing, they may move by up to 6 inches from Harassing (instead of only 3)."
    },
    {
      "name": "Bravery",
      "passive": [
        {
          "hookID": "Morale_OnPreMoraleTest",
          "condition": {
            "kind": "always"
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Morale",
            "delta": 1
          },
          "lifetime": "ThisActivation",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "This model and its unit get \u002B1 to Morale Test rolls."
    },
    {
      "name": "Piercing Marksman",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollComplete",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "not",
              "inner": {
                "kind": "isMelee"
              }
            },
            "right": {
              "kind": "distanceGreaterThan",
              "distanceInches": 9
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Save",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "When shooting at enemies over 9 inches away, this model\u0027s weapons get AP(\u002B1)."
    }
