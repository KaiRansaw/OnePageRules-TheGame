  "ruleDefinitions": [
    {
      "name": "Changebound",
      "passive": [
        {
          "hookID": "Shooting_OnHitRollModifier",
          "condition": {
            "kind": "and",
            "left": {
              "kind": "attackedFromOverInches",
              "distanceInches": 9
            },
            "right": {
              "kind": "allModelsHaveThisRule"
            }
          },
          "effect": {
            "kind": "rollModifier",
            "rollKind": "Hit",
            "delta": -1
          },
          "lifetime": "ThisAttack",
          "seat": "Subject"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Enemies shooting or charging this unit from over 9 inches away get -1 to hit."
    },
    {
      "name": "Versatile Defense Aura",
      "passive": [
