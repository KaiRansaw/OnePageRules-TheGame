            "heroWithinInches": 6,
            "oncePerGame": true
          },
          "lifetime": "UntilEndOfGame",
          "seat": "Actor"
        }
      ],
      "activated": [],
      "scope": "Unit",
      "engineArgumentCount": 0,
      "valence": "Positive",
      "description": "Only one use per game. If this unit is within 24\u0022 of another friendly unit with this rule that is within 6\u0022 of a friendly Hero, then that Hero may use special rules that allow it to pick friendly units within 12\u0022 (except for spells) on this unit as if it was in range."
    },
